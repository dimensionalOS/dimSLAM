{
 "name": "roscon_multi_imu",
 "description": "Handheld rig at ROSCon, 15.5 min: Mid-360 lidar with two IMUs, the Mid-360's own and a RealSense's (noisier, mounted on the camera, away from the lidar). The body is the Mid-360 IMU's frame; the RealSense IMU is placed by the recording's tf_static (rotation and lever arm). The RealSense IMU's stamps run 3 ms late against the Mid-360's (its gyro, turned into the Mid-360's axes, matches best shifted by -3 ms). Scored against the recorded live Point-LIO (Mid-360 IMU only).",
 "recording": "roscon/roscon_jpeg.db",
 "mode": "slam",
 "tf_stream": "tf_static",
 "tf_ignored_parents": [
  "odom"
 ],
 "imus": [
  {
   "stream": "livox_imu"
  },
  {
   "stream": "realsense_imu",
   "time_offset_seconds": -0.003
  }
 ],
 "lidars": [
  "livox_lidar"
 ],
 "reference": {
  "stream": "pointlio_odometry",
  "carry_to": "livox_imu_frame"
 },
 "rest": {
  "stream": "pointlio_odometry",
  "speed": 0.05,
  "angular_speed": 0.05,
  "min_seconds": 1.0,
  "trim_seconds": 0.3
 },
 "config": {
  "odom_frame_id": "odom",
  "output_frame_id": "livox_imu_frame",
  "imus": [
   {
    "frame_id": "livox_imu_frame"
   },
   {
    "frame_id": "camera_imu_frame",
    "gyro_variance": 0.03,
    "accel_variance": 0.02,
    "gyro_clip": 17.45,
    "accel_clip_g": 4.0
   }
  ],
  "lidars": [
   {
    "frame_id": "livox_frame"
   }
  ]
 },
 "variants": {
  "mid360_imu": {
   "/imus": [
    {
     "frame_id": "livox_imu_frame"
    }
   ]
  },
  "both_imus": {},
  "realsense_imu": {
   "/imus": [
    {
     "frame_id": "camera_imu_frame",
     "gyro_variance": 0.03,
     "accel_variance": 0.02,
     "gyro_clip": 17.45,
     "accel_clip_g": 4.0
    }
   ]
  }
 },
 "expect": {
  "mid360_imu": {
   "ate_xy_mm_mean": {
    "max": 27.6
   }
  },
  "both_imus": {
   "ate_xy_mm_mean": {
    "max": 28.9
   }
  },
  "realsense_imu": {
   "ate_xy_mm_mean": {
    "max": 39.4
   }
  }
 },
 "baseline": {
  "note": "2026-10-31 Mac; bounds: both <= 1.1x and RealSense alone <= 1.5x the Mid-360-only run (26.29 mm)",
  "mid360_imu": {
   "ate_xy_mm_mean": 26.29
  },
  "both_imus": {
   "ate_xy_mm_mean": 24.64
  }
 }
}